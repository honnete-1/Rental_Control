# Rental_Control backend configuration.
# Copy to backend/.env and fill in. Never commit the real .env file.

# --- Core -------------------------------------------------------------
# true only on your own computer. Must be false in production.
DJANGO_DEBUG=true
# Long random value. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Required when DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=
# Comma-separated host names the API may be reached on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to send forms (the web app's address).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public address of the web app (used in invitation and password-reset links).
FRONTEND_URL=http://localhost:5173

# --- Database ---------------------------------------------------------
# PostgreSQL is the supported database. Leave empty to use a local SQLite
# file for quick development only.
# DATABASE_URL=postgres://rental_control:CHANGE_ME@localhost:5432/rental_control
DATABASE_URL=
DB_CONN_MAX_AGE=60

# --- Uploaded files -----------------------------------------------------
# local = files saved on this server's disk (MEDIA_ROOT).
# s3    = any S3-compatible storage (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces…).
#         Also run: pip install "django-storages[s3]"
STORAGE_BACKEND=local
MEDIA_ROOT=
MAX_UPLOAD_MB=8
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (invitations, password reset) --------------------------------
# By default emails are printed in the backend console. For real email:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Rental_Control <no-reply@example.com>

# --- Security -------------------------------------------------------------
# Secure cookies default to on when DJANGO_DEBUG=false.
# SECURE_COOKIES=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=3600
# Rate limits (Django REST Framework format, e.g. 10/min).
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_UPLOADS=60/hour
LOG_LEVEL=INFO

# --- Development demo data -------------------------------------------------
# Allows `python manage.py seed_demo`. Defaults to the value of DJANGO_DEBUG.
# Never enable in production.
ALLOW_DEMO_SEED=true
# Password for the fictional demo accounts (at least 8 characters).
DEMO_PASSWORD=
